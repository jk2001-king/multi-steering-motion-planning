#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-9.070060868397285, -115.0436295290894, 28.4575978394059)
                double3 target = (-11.30260212951609, 16.225192148593067, 1.1773250693647341)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary navmeshSettings = {
            double agentHeight = 1.8
            double agentMaxFloorSlope = 45
            double agentMaxStepHeight = 0.4
            double agentRadius = 0.2
            dictionary areas = {
                dictionary "0" = {
                    string areaName = "Walkable"
                    float3 color = (0.2, 0.8, 1)
                    double defaultCost = 1
                }
            }
            bool excludeRigidBodies = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./hospital_experiment.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary patientTransportAckermannReference = {
            double frontRawZeroDeg = 90
            string physicalAngleDefinition = "physical_deg = raw_deg - 90"
            double rawLowerLimitDeg = 45
            double rawUpperLimitDeg = 135
            double rearRawZeroDeg = 90
            string source = "isaac_ackermann_zero_check run01"
        }
        dictionary patientTransportSteeringCalibration = {
            double equivalentFriction = 0.0025
            int physicsHz = 120
            string source = "real ground steering data; Isaac mu=0.0025 runs 01-03"
            double steeringKd = 1000
            double steeringKp = 10000
            double steeringLimitDeg = 45
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    over "patient_transport" (
        prepend references = @../../../../patient_transport_description/urdf/patient_transport/patient_transport.usd@
    )
    {
        string isaac:namespace (
            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )

        over "joints"
        {
            over "caster_fl_swivel_joint"
            {
                uniform token drive:angular:physics:type = "force"
                string isaac:nameOverride (
                    displayName = "Name Override"
                    doc = "Name override for prim lookup in base name search"
                )
            }

            over "caster_fl_wheel_joint"
            {
                uniform token drive:angular:physics:type = "force"
                string isaac:nameOverride (
                    displayName = "Name Override"
                    doc = "Name override for prim lookup in base name search"
                )
            }

            over "caster_fr_swivel_joint"
            {
