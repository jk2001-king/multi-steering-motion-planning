            over "rear_steering_joint"
            {
                float drive:angular:physics:damping = 1000
                float drive:angular:physics:maxForce = 1500
                float drive:angular:physics:stiffness = 10000
                float drive:angular:physics:targetPosition = 90
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "acceleration"
                string isaac:nameOverride (
                    displayName = "Name Override"
                    doc = "Name override for prim lookup in base name search"
                )
                float physics:lowerLimit = 45
                float physics:upperLimit = 135
                float state:angular:physics:position = 90
                float state:angular:physics:velocity = 0
            }

            over "front_wheel_joint"
            {
                float drive:angular:physics:damping = 1
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                string isaac:nameOverride (
                    displayName = "Name Override"
                    doc = "Name override for prim lookup in base name search"
                )
            }

            over "rear_wheel_joint"
            {
                float drive:angular:physics:damping = 1
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                string isaac:nameOverride (
                    displayName = "Name Override"
                    doc = "Name override for prim lookup in base name search"
